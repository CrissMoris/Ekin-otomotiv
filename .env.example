# Ekin Otomotiv — ortam değişkenleri
#
# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldurun (yerel bilgisayar için).
# Vercel'de aynı değişkenleri Project Settings → Environment Variables bölümüne girin.
# ".env.local" Git'e EKLENMEZ; gerçek şifreleri ve anahtarları asla bu dosyaya (.env.example) yazmayın.
#
# Veriler MongoDB'de, fotoğraflar Cloudinary'de tutulur.

# --- Yönetici PIN'i (zorunlu) — yönetim paneline giriş için yalnızca rakamlardan oluşan PIN ---
ADMIN_PASSWORD=

# --- Oturum anahtarı (canlıda önerilir) — en az 32 karakterlik rastgele değer ---
SESSION_SECRET=

# --- Sitenin canlı adresi (arama motorları ve paylaşım önizlemeleri için), ör. https://www.ekinotomotiv.com ---
SITE_URL=

# --- MongoDB Atlas (araçlar ve talepler) ---
# Atlas → Connect → Drivers adresi; <db_password> yerine veritabanı kullanıcısının şifresi yazılır
MONGODB_URI=
MONGODB_DB=ekin-otomotiv

# --- Cloudinary (araç fotoğrafları) ---
# Ya aşağıdaki üç satırı doldurun ya da Cloudinary panelindeki tek satırlık
# "API environment variable" değerini yapıştırın: CLOUDINARY_URL=cloudinary://...
CLOUDINARY_URL=
# veya ayrı ayrı:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
